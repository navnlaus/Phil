[Desktop Entry]
Type=Application
Name=imageview
GenericName=Image Viewer
Comment=View images, and the others in their folder
Exec=@BIN@ %f
Icon=image-viewer
Terminal=false
Categories=Graphics;Viewer;
Keywords=image;picture;photo;viewer;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/avif;image/heic;image/heif;image/jxl;image/tiff;image/bmp;image/svg+xml;image/x-icon;image/vnd.microsoft.icon;image/jp2;
StartupWMClass=imageview
