[Desktop Entry]
Type=Application
Name=imageresize
GenericName=Image Resizer
Comment=Resize, crop and compress an image
Exec=@BIN@ %f
Icon=image-x-generic
Terminal=false
Categories=Graphics;
Keywords=image;resize;crop;compress;jpeg;optimize;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/avif;image/heic;image/heif;image/jxl;image/tiff;image/bmp;image/svg+xml;image/x-icon;image/vnd.microsoft.icon;image/jp2;
StartupWMClass=imageresize
